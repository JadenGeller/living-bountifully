---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="hero">
  <div class="hero-content">
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .hero {
    text-align: center;
    padding: 4rem 1rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 3rem;
    margin-bottom: 1rem;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-light);
    line-height: 1.8;
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 1rem;
    }

    .hero-title {
      font-size: 2.25rem;
    }
  }
</style>
