---
interface Props {
  title: string;
  subtitle?: string;
  greeting?: string;
  image?: string;
}

const { title, subtitle, greeting, image } = Astro.props;
---

<section class="hero">
  <div class="hero-content">
    {image && <img src={image} alt="" class="hero-image tilt-card tilt-intense" />}
    {greeting && <p class="hero-greeting">{greeting}</p>}
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .hero {
    text-align: center;
    padding: 3.5rem 1.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-content {
    max-width: 540px;
    margin: 0 auto;
  }

  .hero-image {
    display: block;
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
    margin: 0 auto 1rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .hero-greeting {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: 0.25rem;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    margin-bottom: 1.25rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-light);
    line-height: 1.85;
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 1.5rem;
    }

    .hero-image {
      width: 100px;
      height: 100px;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .hero-subtitle {
      font-size: 0.9rem;
    }
  }
</style>
