---
interface Props {
  title: string;
  subtitle?: string;
  greeting?: string;
  image?: string;
}

const { title, subtitle, greeting, image } = Astro.props;
---

<section class="hero">
  <div class="hero-content">
    <div class="hero-header">
      {image && <img src={image} alt="" class="hero-image" />}
      <div class="hero-name">
        {greeting && <p class="hero-greeting">{greeting}</p>}
        <h1 class="hero-title">{title}</h1>
      </div>
    </div>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .hero {
    text-align: left;
    padding: 2.5rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-content {
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  .hero-image {
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }

  .hero-name {
    display: flex;
    flex-direction: column;
  }

  .hero-greeting {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-text-light);
    margin-bottom: 0.2rem;
    font-style: italic;
    font-weight: 300;
  }

  .hero-title {
    font-size: 2.25rem;
    margin-bottom: 0;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2rem 1rem;
    }

    .hero-title {
      font-size: 1.75rem;
    }

    .hero-image {
      width: 56px;
      height: 56px;
    }
  }
</style>
