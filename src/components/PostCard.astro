---
interface Props {
  title: string;
  date: Date;
  category: string;
  slug: string;
  image?: string;
  excerpt?: string;
}

const { title, date, category, slug, image, excerpt } = Astro.props;
const base = import.meta.env.BASE_URL;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const imageUrl = image?.startsWith('/') ? base + image : image;
---

<article class="post-card tilt-card">
  <a href={`${base}/posts/${slug}`} class="post-link">
    {imageUrl && (
      <div class="post-image">
        <img src={imageUrl} alt={title} loading="lazy" />
      </div>
    )}
    <div class="post-content">
      <span class="post-category">{category}</span>
      <h2 class="post-title">{title}</h2>
      {excerpt && <p class="post-excerpt">{excerpt}</p>}
      <time class="post-date" datetime={date.toISOString()}>{formattedDate}</time>
    </div>
  </a>
</article>

<style>
  .post-card {
    --tx: 0px;
    --ty: 0px;
    --rx: 0deg;
    --ry: 0deg;
    --scale: 1;
    background: transparent;
    border-radius: 12px;
    transform: perspective(600px) translateX(var(--tx)) translateY(var(--ty)) rotateX(var(--rx)) rotateY(var(--ry)) scale(var(--scale));
    transition:
      transform 0.5s cubic-bezier(0.33, 1, 0.68, 1),
      box-shadow 0.3s ease;
  }

  .post-card:hover {
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transform: none !important;
    }
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.06),
      0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-content {
    padding: 1.5rem;
  }

  .post-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .post-title {
    font-size: 1.25rem;
    margin: 0.5rem 0 0.75rem;
    color: var(--color-text);
    line-height: 1.4;
  }

  .post-excerpt {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }
</style>
