---
interface Props {
  name: string;
  bio: string;
  image?: string;
}

const { name, bio, image } = Astro.props;
---

<section class="author-intro">
  <div class="author-content">
    {image && <img src={image} alt={name} class="author-image tilt-card tilt-scale-lg" />}
    <p class="author-greeting">Hello,</p>
    <h1 class="author-name">I'm {name}</h1>
    <p class="author-bio">{bio}</p>
  </div>
</section>

<style>
  .author-intro {
    text-align: center;
    padding: 3.5rem 1.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .author-content {
    max-width: 540px;
    margin: 0 auto;
  }

  .author-image {
    display: block;
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
    margin: 0 auto 1rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .author-greeting {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: 0.25rem;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .author-name {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    margin-bottom: 1.25rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .author-bio {
    font-size: 0.95rem;
    color: var(--color-text-light);
    line-height: 1.85;
    margin: 0;
  }

  @media (max-width: 640px) {
    .author-intro {
      padding: 2.5rem 1.5rem;
    }

    .author-image {
      width: 100px;
      height: 100px;
    }

    .author-name {
      font-size: 2.25rem;
    }

    .author-bio {
      font-size: 0.9rem;
    }
  }
</style>
