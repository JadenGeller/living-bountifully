---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="page-header">
  <h1>{title}</h1>
</header>

<style>
  .page-header {
    text-align: center;
    padding: 3rem 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    margin: 0;
  }

  @media (max-width: 640px) {
    .page-header {
      padding: 2rem 1.5rem;
    }

    .page-header h1 {
      font-size: 2rem;
    }
  }
</style>
