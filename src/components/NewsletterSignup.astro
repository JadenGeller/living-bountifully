---
interface Props {
  buttondownUsername?: string;
}

const { buttondownUsername = 'YOUR_USERNAME' } = Astro.props;
---

<section class="newsletter">
  <h2 class="newsletter-heading">Join the fun!</h2>
  <p class="newsletter-text">Stay updated with my latest adventures by joining my newsletter.</p>
  <form
    action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUsername}`}
    method="post"
    target="popupwindow"
    class="newsletter-form"
  >
    <input
      type="email"
      name="email"
      placeholder="Type your email..."
      required
      class="newsletter-input"
    />
    <button type="submit" class="newsletter-button" aria-label="Subscribe">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </button>
  </form>
</section>

<style>
  .newsletter {
    text-align: center;
    padding: 1.25rem 1.5rem;
    background: rgba(139, 115, 85, 0.06);
    border-radius: 8px;
    max-width: 400px;
    margin: 0 auto 2rem;
  }

  .newsletter-heading {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .newsletter-text {
    color: var(--color-text-light);
    font-size: 0.8rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .newsletter-form {
    display: flex;
    max-width: 280px;
    margin: 0 auto;
  }

  .newsletter-input {
    flex: 1;
    padding: 0.5rem 0.65rem;
    font-size: 0.8rem;
    border: 1px solid var(--color-border);
    border-right: none;
    background: #fff;
    color: var(--color-text);
    outline: none;
    font-family: var(--font-sans);
  }

  .newsletter-input::placeholder {
    color: var(--color-text-light);
  }

  .newsletter-input:focus {
    border-color: var(--color-accent);
  }

  .newsletter-button {
    padding: 0.5rem 0.6rem;
    background: var(--color-text);
    border: 1px solid var(--color-text);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .newsletter-button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
