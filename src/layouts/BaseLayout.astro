---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "A travel and lifestyle blog documenting adventures and the little moments that make life beautiful.", image } = Astro.props;
const siteTitle = "Living Bountifully";
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Andrea Nagel" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-container">
        <a href={base} class="site-title">{siteTitle}</a>
        <ul class="nav-links">
          <li><a href={base}>Home</a></li>
          <li><a href={`${base}/wanderlust`}>Wanderlust</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <p>&copy; {new Date().getFullYear()} Living Bountifully. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fdfbf7;
    --color-text: #2d2d2d;
    --color-text-light: #6b6b6b;
    --color-accent: #8b7355;
    --color-accent-light: #c4a77d;
    --color-border: #e8e4dc;
    --font-serif: 'Georgia', 'Times New Roman', serif;
    --font-sans: 'Helvetica Neue', Arial, sans-serif;
    --max-width: 1100px;
    --content-width: 720px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-size: 18px;
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-sans);
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: 1.7;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--color-accent-light);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-serif);
    font-weight: 400;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2.5rem;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 1.8rem;
  }

  h3 {
    font-size: 1.4rem;
  }

  p {
    margin-bottom: 1.5rem;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  ul, ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  blockquote {
    border-left: 3px solid var(--color-accent-light);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-text-light);
  }

  strong {
    font-weight: 600;
  }

  em {
    font-style: italic;
  }

  /* Tilt card effect - add .tilt-card class to any element */
  .tilt-card {
    --tx: 0px;
    --ty: 0px;
    --rx: 0deg;
    --ry: 0deg;
    --scale: 1;
    transform: perspective(600px) translateX(var(--tx)) translateY(var(--ty)) rotateX(var(--rx)) rotateY(var(--ry)) scale(var(--scale));
    transform-style: preserve-3d;
    transition:
      transform 0.5s cubic-bezier(0.33, 1, 0.68, 1),
      box-shadow 0.3s ease;
  }

  /* Images inside tilt-cards zoom out on hover */
  .tilt-card {
    --img-tx: 0px;
    --img-ty: 0px;
    --img-scale: 1.12;
    --img-rx: 0deg;
    --img-ry: 0deg;
  }

  .tilt-card img {
    transform: rotateX(var(--img-rx)) rotateY(var(--img-ry)) translate(var(--img-tx), var(--img-ty)) scale(var(--img-scale));
    transition: transform 0.5s cubic-bezier(0.33, 1, 0.68, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .tilt-card {
      transform: none !important;
    }
    .tilt-card img {
      transform: none !important;
    }
  }
</style>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .site-title:hover {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--color-text-light);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  .site-footer {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding: 2rem 1.5rem;
    margin-top: auto;
  }

  .footer-content {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
    color: var(--color-text-light);
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .nav-container {
      flex-direction: column;
      gap: 1rem;
    }

    .nav-links {
      gap: 1.5rem;
    }

    h1 {
      font-size: 2rem;
    }
  }
</style>

<script>
  // Tilt card effect
  let isScrolling = false;
  let scrollTimeout: number | null = null;
  const cards: HTMLElement[] = [];

  function resetCard(card: HTMLElement) {
    card.style.removeProperty('--tx');
    card.style.removeProperty('--ty');
    card.style.removeProperty('--rx');
    card.style.removeProperty('--ry');
    card.style.removeProperty('--scale');
    card.style.removeProperty('--img-tx');
    card.style.removeProperty('--img-ty');
    card.style.removeProperty('--img-scale');
    card.style.removeProperty('--img-rx');
    card.style.removeProperty('--img-ry');
  }

  window.addEventListener('scroll', () => {
    isScrolling = true;
    cards.forEach(resetCard);
    if (scrollTimeout) clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      isScrolling = false;
    }, 150);
  }, { passive: true });

  document.querySelectorAll('.tilt-card').forEach((el) => {
    const card = el as HTMLElement;
    cards.push(card);
    let rafId: number | null = null;

    card.addEventListener('mousemove', (e) => {
      if (rafId || isScrolling) return;

      rafId = requestAnimationFrame(() => {
        const rect = card.getBoundingClientRect();
        const clamp = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));
        const centerX = clamp(((e.clientX - rect.left) / rect.width - 0.5) * 2, -1, 1);
        const centerY = clamp(((e.clientY - rect.top) / rect.height - 0.5) * 2, -1, 1);
        card.style.setProperty('--tx', `${centerX * 1}px`);
        card.style.setProperty('--ty', `${centerY * 1 - 3}px`);
        card.style.setProperty('--rx', `${centerY * 4}deg`);
        card.style.setProperty('--ry', `${-centerX * 4}deg`);
        card.style.setProperty('--scale', '1.06');
        // Image parallax - translate opposite to mouse, scale down to reveal, counter-rotate to stay flat
        card.style.setProperty('--img-tx', `${-centerX * 1.5}%`);
        card.style.setProperty('--img-ty', `${-centerY * 1.5}%`);
        card.style.setProperty('--img-scale', '1.10');
        card.style.setProperty('--img-rx', `${-centerY * 4}deg`);
        card.style.setProperty('--img-ry', `${centerX * 4}deg`);
        rafId = null;
      });
    });

    card.addEventListener('mouseleave', () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = null;
      resetCard(card);
    });
  });
</script>
