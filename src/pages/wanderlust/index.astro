---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getExcerpt(body: string): string {
  const lines = body.split('\n').filter(line =>
    line.trim() && !line.startsWith('#') && !line.startsWith('!') && !line.startsWith('-') && !line.startsWith('*')
  );
  return lines.slice(0, 5).map(l => l.trim()).join(' ');
}
---

<BaseLayout title="Wanderlust | Living Bountifully">
  <section class="page-intro">
    <p class="page-greeting">Welcome to</p>
    <h1>Wanderlust</h1>
    <p class="page-description">
      A collection of my travel stories, guides, and adventures near and far.
      From weekend getaways to international escapes, this is where I share all the places that have
      sparked curiosity, brought joy, and left me wanting more. Whether you're planning your next trip
      or just here to wander from your screen, I'm so glad you're along for the ride.
    </p>
  </section>

  <section class="posts-grid">
    {sortedPosts.map((post) => (
      <PostCard
        title={post.data.title}
        date={post.data.date}
        category={post.data.category}
        slug={post.id}
        image={post.data.image}
        excerpt={getExcerpt(post.body)}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .page-intro {
    text-align: center;
    padding: 4rem 1rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .page-greeting {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: 0.25rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .page-intro h1 {
    font-size: 2.75rem;
    margin-bottom: 1.25rem;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .page-description {
    font-size: 0.95rem;
    color: var(--color-text-light);
    line-height: 1.85;
    margin: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 640px) {
    .page-intro {
      padding: 2.5rem 1rem;
    }

    .page-intro h1 {
      font-size: 2.25rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
