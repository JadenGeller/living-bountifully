---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const imageUrl = post.data.image?.startsWith('/') ? base + post.data.image : post.data.image;
---

<BaseLayout title={post.data.title} description={post.data.description} image={imageUrl}>
  <article class="post">
    <header class="post-header">
      <a href={`${base}/category/${post.data.category.toLowerCase()}`} class="post-category">
        {post.data.category}
      </a>
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <span class="post-author">Andrea Nagel</span>
        <span class="separator">&middot;</span>
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
      </div>
    </header>

    {imageUrl && (
      <figure class="post-hero-image">
        <img src={imageUrl} alt={post.data.imageAlt || post.data.title} />
      </figure>
    )}

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href={base} class="back-link">&larr; Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .post-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .post-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    display: inline-block;
    margin-bottom: 1rem;
  }

  .post-title {
    font-size: 2.5rem;
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .post-meta {
    color: var(--color-text-light);
    font-size: 0.9rem;
  }

  .separator {
    margin: 0 0.5rem;
  }

  .post-hero-image {
    margin: 0 0 2.5rem;
  }

  .post-hero-image img {
    width: 100%;
    border-radius: 2px;
  }

  .post-content {
    font-size: 1rem;
    line-height: 1.8;
  }

  .post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(img) {
    margin: 2rem 0;
    border-radius: 2px;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-left: 1rem;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .post-title {
      font-size: 1.75rem;
    }
  }

  .post-hero-image img,
  .post-content :global(img) {
    cursor: zoom-in;
  }
</style>

<style is:global>
  header.site-header {
    transition: transform 0.3s ease;
  }

  body.lightbox-open header.site-header {
    transform: translateY(-100%);
    pointer-events: none;
  }

  .lightbox-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg);
    opacity: 0;
    z-index: 97;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .lightbox-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-image {
    position: fixed;
    object-fit: contain;
    z-index: 98;
    cursor: zoom-out;
    transition: left 0.35s cubic-bezier(0.2, 0, 0.2, 1),
                top 0.35s cubic-bezier(0.2, 0, 0.2, 1),
                width 0.35s cubic-bezier(0.2, 0, 0.2, 1),
                height 0.35s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .lightbox-controls {
    position: fixed;
    inset: 0;
    z-index: 99;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .lightbox-controls.active {
    opacity: 1;
  }

  .lightbox-controls button {
    pointer-events: auto;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: var(--color-text);
    font-size: 2rem;
    cursor: pointer;
    opacity: 0.5;
    line-height: 1;
    transition: opacity 0.2s;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--color-text);
    font-size: 2.5rem;
    cursor: pointer;
    opacity: 0.5;
    padding: 1rem;
    transition: opacity 0.2s;
  }

  .lightbox-nav:hover {
    opacity: 1;
  }

  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }

  .lightbox-counter {
    display: none;
  }
</style>

<div class="lightbox-backdrop" id="lightbox-backdrop"></div>
<img class="lightbox-image" id="lightbox-image" src="" alt="" />
<div class="lightbox-controls" id="lightbox-controls">
  <button class="lightbox-close">&times;</button>
  <button class="lightbox-nav lightbox-prev">&#8249;</button>
  <button class="lightbox-nav lightbox-next">&#8250;</button>
  <div class="lightbox-counter"></div>
</div>

<script is:inline>
(function() {
  var backdrop = document.getElementById('lightbox-backdrop');
  var lbImg = document.getElementById('lightbox-image');
  var controls = document.getElementById('lightbox-controls');
  if (!backdrop || !lbImg || !controls) return;
  var counter = controls.querySelector('.lightbox-counter');
  var images = Array.from(document.querySelectorAll('.post-hero-image img, .post-content img'));
  var current = 0;
  var openedAt = 0;
  var hiddenImg = null;
  var isOpen = false;

  function getTargetRect() {
    var vw = window.innerWidth;
    var vh = window.innerHeight;
    var padding = 40;
    var maxW = vw - padding * 2;
    var maxH = vh - padding * 2;

    var img = images[current];
    var naturalW = img.naturalWidth || img.width;
    var naturalH = img.naturalHeight || img.height;
    var ratio = Math.min(maxW / naturalW, maxH / naturalH, 1);
    var w = naturalW * ratio;
    var h = naturalH * ratio;

    return {
      left: (vw - w) / 2,
      top: (vh - h) / 2,
      width: w,
      height: h
    };
  }

  function setImageRect(rect) {
    lbImg.style.left = rect.left + 'px';
    lbImg.style.top = rect.top + 'px';
    lbImg.style.width = rect.width + 'px';
    lbImg.style.height = rect.height + 'px';
  }

  function show(i, animate) {
    // Restore previously hidden image
    if (hiddenImg) {
      hiddenImg.style.visibility = '';
    }

    current = (i + images.length) % images.length;
    var srcImg = images[current];

    // Hide new current image
    srcImg.style.visibility = 'hidden';
    hiddenImg = srcImg;

    lbImg.src = srcImg.src;
    lbImg.alt = srcImg.alt;
    counter.textContent = (current + 1) + ' / ' + images.length;

    if (animate !== false) {
      var target = getTargetRect();
      setImageRect(target);
    }
  }

  function open(i) {
    current = i;
    openedAt = i;
    var srcImg = images[i];
    var rect = srcImg.getBoundingClientRect();

    // Hide source image, show lightbox image
    srcImg.style.visibility = 'hidden';
    hiddenImg = srcImg;
    lbImg.style.visibility = '';

    lbImg.src = srcImg.src;
    lbImg.alt = srcImg.alt;
    counter.textContent = (i + 1) + ' / ' + images.length;

    // Start at source position
    lbImg.style.transition = 'none';
    setImageRect(rect);

    // Force reflow
    lbImg.offsetHeight;

    // Animate to target
    lbImg.style.transition = '';
    backdrop.classList.add('active');
    controls.classList.add('active');
    isOpen = true;

    requestAnimationFrame(function() {
      var target = getTargetRect();
      setImageRect(target);
    });

    document.body.style.overflow = 'hidden';
    document.body.classList.add('lightbox-open');
  }

  function close() {
    var srcImg = images[current];

    // Scroll to current image if we navigated to a different one
    if (current !== openedAt) {
      srcImg.scrollIntoView({ behavior: 'instant', block: 'center' });
    }

    var rect = srcImg.getBoundingClientRect();

    backdrop.classList.remove('active');
    controls.classList.remove('active');
    setImageRect(rect);
    document.body.classList.remove('lightbox-open');

    // After animation, reset everything
    setTimeout(function() {
      lbImg.style.visibility = 'hidden';
      if (hiddenImg) {
        hiddenImg.style.visibility = '';
        hiddenImg = null;
      }
    }, 350);

    isOpen = false;
    document.body.style.overflow = '';
  }

  images.forEach(function(image, i) {
    image.addEventListener('click', function() { open(i); });
  });

  controls.querySelector('.lightbox-close').addEventListener('click', close);
  controls.querySelector('.lightbox-prev').addEventListener('click', function() { show(current - 1); });
  controls.querySelector('.lightbox-next').addEventListener('click', function() { show(current + 1); });

  backdrop.addEventListener('click', close);
  lbImg.addEventListener('click', close);

  document.addEventListener('keydown', function(e) {
    if (!isOpen) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  window.addEventListener('resize', function() {
    if (isOpen) {
      var target = getTargetRect();
      setImageRect(target);
    }
  });
})();
</script>
